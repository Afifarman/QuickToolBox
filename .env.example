# QuickToolBox Environment Configuration
#
# Copy this file to .env.local for local development.
# For Vercel deployments, set these in Project Settings → Environment Variables.

# Supabase project URL — find in Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Supabase anon / publishable key — find in Project Settings → API
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Alternative name (both are supported):
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Canonical production URL — used as fallback origin for OAuth callbacks.
# Set this to the live Vercel deployment URL.
NEXT_PUBLIC_SITE_URL=https://quick-tool-box-gamma.vercel.app